//! Generalized implementation of all 42 core R7RS primitives.
//!
//! This module demonstrates the power of the generic primitive system by
//! implementing all core Scheme primitives with minimal boilerplate and
//! maximum performance optimization opportunities.

use crate::eval::Value;
use crate::jit::generic_primitives::*;
use crate::diagnostics::UnifiedResult;

// Import macro system
use crate::{
    define_arithmetic_primitive, define_comparison_primitive, 
    define_type_predicate, define_list_primitive, define_jit_primitive
};

/// Registers all 42 core primitives with a registry.
pub fn register_all_core_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Register arithmetic primitives (12 total)
    register_arithmetic_primitives(registry)?;
    
    // Register comparison primitives (6 total)
    register_comparison_primitives(registry)?;
    
    // Register list primitives (8 total)
    register_list_primitives(registry)?;
    
    // Register type predicate primitives (6 total)
    register_type_predicate_primitives(registry)?;
    
    // Register equality and logic primitives (4 total)
    register_equality_primitives(registry)?;
    
    // Register control flow primitives (3 total)
    register_control_flow_primitives(registry)?;
    
    // Register I/O primitives (3 total)
    register_io_primitives(registry)?;
    
    Ok(())
}

/// Registers arithmetic primitives using macro-generated implementations.
fn register_arithmetic_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Addition (+)
    define_arithmetic_primitive!(
        "+",
        identity: 0.0,
        operation: |a, b| a + b
    );
    
    // Subtraction (-)
    define_arithmetic_primitive!(
        "-",
        identity: 0.0,
        associative: false,
        commutative: false,
        operation: |a, b| a - b
    );
    
    // Multiplication (*)
    define_arithmetic_primitive!(
        "*",
        identity: 1.0,
        operation: |a, b| a * b
    );
    
    // Division (/)
    define_arithmetic_primitive!(
        "/",
        identity: 1.0,
        associative: false,
        commutative: false,
        operation: |a, b| {
            if b == 0.0 {
                return Err(crate::eval::unified_eval_errors::EvalUnifiedError::division_by_zero().into_unified());
            }
            a / b
        }
    );
    
    // Quotient
    define_jit_primitive! {
        name: "quotient",
        category: ArithmeticCategory,
        arity_min: 2,
        arity_max: Some(2),
        commutative: false,
        associative: false,
        side_effects: false,
        constant_fold: true,
        eval: |args| {
            let a = crate::validate_type!(args[0], number)?;
            let b = crate::validate_type!(args[1], number)?;
            
            if b == 0.0 {
                return Err(crate::eval::unified_eval_errors::EvalUnifiedError::division_by_zero().into_unified());
            }
            
            Ok(Value::number((a / b).trunc()))
        }
    }
    
    // Remainder
    define_jit_primitive! {
        name: "remainder",
        category: ArithmeticCategory,
        arity_min: 2,
        arity_max: Some(2),
        commutative: false,
        associative: false,
        side_effects: false,
        constant_fold: true,
        eval: |args| {
            let a = crate::validate_type!(args[0], number)?;
            let b = crate::validate_type!(args[1], number)?;
            
            if b == 0.0 {
                return Err(crate::eval::unified_eval_errors::EvalUnifiedError::division_by_zero().into_unified());
            }
            
            Ok(Value::number(a % b))
        }
    }
    
    // Modulo
    define_jit_primitive! {
        name: "modulo",
        category: ArithmeticCategory,
        arity: 2,
        eval: |args| {
            let a = crate::validate_type!(args[0], number)?;
            let b = crate::validate_type!(args[1], number)?;
            
            if b == 0.0 {
                return Err(crate::eval::unified_eval_errors::EvalUnifiedError::division_by_zero().into_unified());
            }
            
            // Scheme modulo has different semantics than Rust %
            let result = a - b * (a / b).floor();
            Ok(Value::number(result))
        }
    }
    
    // Absolute value
    define_jit_primitive! {
        name: "abs",
        category: ArithmeticCategory,
        arity: 1,
        eval: |args| {
            let n = crate::validate_type!(args[0], number)?;
            Ok(Value::number(n.abs()))
        }
    }
    
    // Greatest common divisor
    define_jit_primitive! {
        name: "gcd",
        category: ArithmeticCategory,
        arity_min: 0,
        variadic: true,
        eval: |args| {
            if args.is_empty() {
                return Ok(Value::number(0.0));
            }
            
            let mut result = crate::validate_type!(args[0], number)?.abs() as i64;
            
            for arg in &args[1..] {
                let n = crate::validate_type!(arg.clone(), number)?.abs() as i64;
                result = gcd_impl(result, n);
            }
            
            Ok(Value::number(result as f64))
        }
    }
    
    // Least common multiple
    define_jit_primitive! {
        name: "lcm",
        category: ArithmeticCategory,
        arity_min: 0,
        variadic: true,
        eval: |args| {
            if args.is_empty() {
                return Ok(Value::number(1.0));
            }
            
            let mut result = crate::validate_type!(args[0], number)?.abs() as i64;
            
            for arg in &args[1..] {
                let n = crate::validate_type!(arg.clone(), number)?.abs() as i64;
                result = (result * n) / gcd_impl(result, n);
            }
            
            Ok(Value::number(result as f64))
        }
    }
    
    // Floor
    define_jit_primitive! {
        name: "floor",
        category: ArithmeticCategory,
        arity: 1,
        eval: |args| {
            let n = crate::validate_type!(args[0], number)?;
            Ok(Value::number(n.floor()))
        }
    }
    
    // Ceiling
    define_jit_primitive! {
        name: "ceiling",
        category: ArithmeticCategory,
        arity: 1,
        eval: |args| {
            let n = crate::validate_type!(args[0], number)?;
            Ok(Value::number(n.ceil()))
        }
    }

    // Register all arithmetic primitives
    registry.register(AddPrimitive)?;
    registry.register(SubtractPrimitive)?;
    registry.register(MultiplyPrimitive)?;
    registry.register(DividePrimitive)?;
    registry.register(QuotientPrimitive)?;
    registry.register(RemainderPrimitive)?;
    registry.register(ModuloPrimitive)?;
    registry.register(AbsPrimitive)?;
    registry.register(GcdPrimitive)?;
    registry.register(LcmPrimitive)?;
    registry.register(FloorPrimitive)?;
    registry.register(CeilingPrimitive)?;
    
    Ok(())
}

/// Registers comparison primitives with optimized implementations.
fn register_comparison_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Numeric equality (=)
    define_comparison_primitive!(
        "=",
        |a, b| (a - b).abs() < f64::EPSILON
    );
    
    // Less than (<)
    define_comparison_primitive!(
        "<",
        |a, b| a < b
    );
    
    // Greater than (>)
    define_comparison_primitive!(
        ">",
        |a, b| a > b
    );
    
    // Less than or equal (<=)
    define_comparison_primitive!(
        "<=",
        |a, b| a <= b
    );
    
    // Greater than or equal (>=)
    define_comparison_primitive!(
        ">=",
        |a, b| a >= b
    );
    
    // Maximum
    define_jit_primitive! {
        name: "max",
        category: ComparisonCategory,
        arity_min: 1,
        variadic: true,
        eval: |args| {
            let mut result = crate::validate_type!(args[0], number)?;
            
            for arg in &args[1..] {
                let n = crate::validate_type!(arg.clone(), number)?;
                if n > result {
                    result = n;
                }
            }
            
            Ok(Value::number(result))
        }
    }

    registry.register(EqualPrimitive)?;
    registry.register(LessThanPrimitive)?;
    registry.register(GreaterThanPrimitive)?;
    registry.register(LessEqualPrimitive)?;
    registry.register(GreaterEqualPrimitive)?;
    registry.register(MaxPrimitive)?;
    
    Ok(())
}

/// Registers list operation primitives.
fn register_list_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Cons
    define_list_primitive!(
        "cons",
        |args| {
            Ok(Value::cons(args[0].clone(), args[1].clone()))
        }
    );
    
    // Car
    define_list_primitive!(
        "car",
        |args| {
            match &args[0] {
                Value::Pair(car, _) => Ok(car.as_ref().clone()),
                Value::Nil => Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
                    "pair", args[0].clone()
                ).into_unified()),
                _ => Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
                    "pair", args[0].clone()
                ).into_unified()),
            }
        }
    );
    
    // Cdr
    define_list_primitive!(
        "cdr",
        |args| {
            match &args[0] {
                Value::Pair(_, cdr) => Ok(cdr.as_ref().clone()),
                Value::Nil => Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
                    "pair", args[0].clone()
                ).into_unified()),
                _ => Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
                    "pair", args[0].clone()
                ).into_unified()),
            }
        }
    );
    
    // Null?
    define_list_primitive!(
        "null?",
        |args| {
            Ok(Value::boolean(matches!(args[0], Value::Nil)))
        }
    );
    
    // Pair?
    define_list_primitive!(
        "pair?",
        |args| {
            Ok(Value::boolean(matches!(args[0], Value::Pair(_, _))))
        }
    );
    
    // List constructor
    define_list_primitive!(
        "list",
        arity_min: 0,
        variadic: true,
        operation: |args| {
            let mut result = Value::Nil;
            for arg in args.iter().rev() {
                result = Value::cons(arg.clone(), result);
            }
            Ok(result)
        }
    );
    
    // Length
    define_list_primitive!(
        "length",
        arity: 1,
        operation: |args| {
            let mut count = 0;
            let mut current = &args[0];
            
            loop {
                match current {
                    Value::Nil => return Ok(Value::number(count as f64)),
                    Value::Pair(_, cdr) => {
                        count += 1;
                        current = cdr;
                    }
                    _ => return Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
                        "proper list", args[0].clone()
                    ).into_unified()),
                }
            }
        }
    );
    
    // Append
    define_list_primitive!(
        "append",
        arity_min: 0,
        variadic: true,
        operation: |args| {
            if args.is_empty() {
                return Ok(Value::Nil);
            }
            
            let mut result = args.last().unwrap().clone();
            
            for arg in args.iter().rev().skip(1) {
                result = append_lists(arg.clone(), result)?;
            }
            
            Ok(result)
        }
    );

    registry.register(ConsPrimitive)?;
    registry.register(CarPrimitive)?;
    registry.register(CdrPrimitive)?;
    registry.register(NullQuestionPrimitive)?;
    registry.register(PairQuestionPrimitive)?;
    registry.register(ListPrimitive)?;
    registry.register(LengthPrimitive)?;
    registry.register(AppendPrimitive)?;
    
    Ok(())
}

/// Registers type predicate primitives with maximum inlining.
fn register_type_predicate_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Number?
    define_type_predicate!("number?", check: |value| matches!(value, Value::Number(_)));
    
    // String?
    define_type_predicate!("string?", check: |value| matches!(value, Value::String(_)));
    
    // Symbol?
    define_type_predicate!("symbol?", check: |value| matches!(value, Value::Symbol(_)));
    
    // Boolean?
    define_type_predicate!("boolean?", check: |value| matches!(value, Value::Boolean(_)));
    
    // Procedure?
    define_type_predicate!("procedure?", check: |value| 
        matches!(value, Value::Closure(_, _, _) | Value::Primitive(_))
    );
    
    // Vector?
    define_type_predicate!("vector?", check: |value| matches!(value, Value::Vector(_)));

    registry.register(NumberQuestionPrimitive)?;
    registry.register(StringQuestionPrimitive)?;
    registry.register(SymbolQuestionPrimitive)?;
    registry.register(BooleanQuestionPrimitive)?;
    registry.register(ProcedureQuestionPrimitive)?;
    registry.register(VectorQuestionPrimitive)?;
    
    Ok(())
}

/// Registers equality and logic primitives.
fn register_equality_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // eq? (reference equality)
    define_jit_primitive! {
        name: "eq?",
        category: ComparisonCategory,
        arity: 2,
        eval: |args| {
            Ok(Value::boolean(std::ptr::eq(&args[0], &args[1])))
        }
    }
    
    // eqv? (equivalence)
    define_jit_primitive! {
        name: "eqv?",
        category: ComparisonCategory,
        arity: 2,
        eval: |args| {
            Ok(Value::boolean(values_eqv(&args[0], &args[1])))
        }
    }
    
    // equal? (structural equality)
    define_jit_primitive! {
        name: "equal?",
        category: ComparisonCategory,
        arity: 2,
        eval: |args| {
            Ok(Value::boolean(values_equal(&args[0], &args[1])))
        }
    }
    
    // not (logical negation)
    define_jit_primitive! {
        name: "not",
        category: ComparisonCategory,
        arity: 1,
        eval: |args| {
            Ok(Value::boolean(matches!(args[0], Value::Boolean(false))))
        }
    }

    registry.register(EqQuestionPrimitive)?;
    registry.register(EqvQuestionPrimitive)?;
    registry.register(EqualQuestionPrimitive)?;
    registry.register(NotPrimitive)?;
    
    Ok(())
}

/// Registers control flow primitives.
fn register_control_flow_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Apply
    define_jit_primitive! {
        name: "apply",
        category: ListCategory, // Uses list category for now
        arity_min: 2,
        variadic: true,
        commutative: false,
        associative: false,
        side_effects: true,
        constant_fold: false,
        eval: |args| {
            // This is a simplified implementation
            // Real apply would need access to the evaluator
            Err(crate::eval::unified_eval_errors::EvalUnifiedError::new(
                crate::eval::unified_eval_errors::EvalErrorKind::InvalidOperation,
                "apply requires evaluator context"
            ).into_unified())
        }
    }
    
    // call/cc (call with current continuation)
    define_jit_primitive! {
        name: "call/cc",
        category: ListCategory, // Uses list category for now
        arity: 1,
        commutative: false,
        associative: false,
        side_effects: true,
        constant_fold: false,
        eval: |args| {
            // This is a simplified implementation
            // Real call/cc would need continuation capture
            Err(crate::eval::unified_eval_errors::EvalUnifiedError::new(
                crate::eval::unified_eval_errors::EvalErrorKind::ContinuationFailure,
                "call/cc requires continuation support"
            ).into_unified())
        }
    }
    
    // values (multiple value constructor)
    define_jit_primitive! {
        name: "values",
        category: ListCategory,
        arity_min: 0,
        variadic: true,
        eval: |args| {
            match args.len() {
                0 => Ok(Value::Nil),
                1 => Ok(args[0].clone()),
                _ => {
                    // Multiple values - would need special handling
                    Ok(Value::list(args.to_vec()))
                }
            }
        }
    }

    registry.register(ApplyPrimitive)?;
    registry.register(CallCcPrimitive)?;
    registry.register(ValuesPrimitive)?;
    
    Ok(())
}

/// Registers I/O primitives.
fn register_io_primitives(registry: &mut GenericPrimitiveRegistry) -> crate::diagnostics::Result<()> {
    // Display
    define_jit_primitive! {
        name: "display",
        category: ListCategory, // Uses list category for now
        arity_min: 1,
        arity_max: Some(2),
        commutative: false,
        associative: false,
        side_effects: true,
        constant_fold: false,
        eval: |args| {
            // Simplified display implementation
            print!("{}", format_value_for_display(&args[0]));
            Ok(Value::Nil)
        }
    }
    
    // Newline
    define_jit_primitive! {
        name: "newline",
        category: ListCategory,
        arity_min: 0,
        arity_max: Some(1),
        eval: |args| {
            println!();
            Ok(Value::Nil)
        }
    }
    
    // Read
    define_jit_primitive! {
        name: "read",
        category: ListCategory,
        arity_min: 0,
        arity_max: Some(1),
        eval: |args| {
            // Simplified read implementation
            Err(crate::eval::unified_eval_errors::EvalUnifiedError::new(
                crate::eval::unified_eval_errors::EvalErrorKind::InvalidOperation,
                "read requires parser context"
            ).into_unified())
        }
    }

    registry.register(DisplayPrimitive)?;
    registry.register(NewlinePrimitive)?;
    registry.register(ReadPrimitive)?;
    
    Ok(())
}

// Helper functions

fn gcd_impl(a: i64, b: i64) -> i64 {
    if b == 0 { a } else { gcd_impl(b, a % b) }
}

fn append_lists(list1: Value, list2: Value) -> UnifiedResult<Value> {
    match list1 {
        Value::Nil => Ok(list2),
        Value::Pair(car, cdr) => {
            let appended_cdr = append_lists(cdr.as_ref().clone(), list2)?;
            Ok(Value::cons(car.as_ref().clone(), appended_cdr))
        }
        _ => Err(crate::eval::unified_eval_errors::EvalUnifiedError::type_mismatch(
            "list", list1
        ).into_unified()),
    }
}

fn values_eqv(a: &Value, b: &Value) -> bool {
    match (a, b) {
        (Value::Number(x), Value::Number(y)) => (x - y).abs() < f64::EPSILON,
        (Value::Boolean(x), Value::Boolean(y)) => x == y,
        (Value::Symbol(x), Value::Symbol(y)) => x == y,
        _ => std::ptr::eq(a, b),
    }
}

fn values_equal(a: &Value, b: &Value) -> bool {
    match (a, b) {
        (Value::Number(x), Value::Number(y)) => (x - y).abs() < f64::EPSILON,
        (Value::Boolean(x), Value::Boolean(y)) => x == y,
        (Value::String(x), Value::String(y)) => x == y,
        (Value::Symbol(x), Value::Symbol(y)) => x == y,
        (Value::Pair(car1, cdr1), Value::Pair(car2, cdr2)) => {
            values_equal(car1, car2) && values_equal(cdr1, cdr2)
        }
        (Value::Vector(v1), Value::Vector(v2)) => {
            v1.len() == v2.len() && v1.iter().zip(v2.iter()).all(|(a, b)| values_equal(a, b))
        }
        _ => values_eqv(a, b),
    }
}

fn format_value_for_display(value: &Value) -> String {
    match value {
        Value::Number(n) => n.to_string(),
        Value::String(s) => s.clone(),
        Value::Symbol(s) => s.clone(),
        Value::Boolean(b) => if *b { "#t" } else { "#f" }.to_string(),
        Value::Nil => "()".to_string(),
        Value::Pair(_, _) => format_list_for_display(value),
        Value::Vector(v) => {
            let elements: Vec<String> = v.iter().map(format_value_for_display).collect();
            format!("#({})", elements.join(" "))
        }
        _ => format!("#<{}>", value.type_name()),
    }
}

fn format_list_for_display(value: &Value) -> String {
    let mut result = String::from("(");
    let mut current = value;
    let mut first = true;
    
    loop {
        match current {
            Value::Nil => {
                result.push(')');
                break;
            }
            Value::Pair(car, cdr) => {
                if !first {
                    result.push(' ');
                }
                result.push_str(&format_value_for_display(car));
                current = cdr;
                first = false;
            }
            _ => {
                result.push_str(" . ");
                result.push_str(&format_value_for_display(current));
                result.push(')');
                break;
            }
        }
    }
    
    result
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_all_primitives_registration() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_all_core_primitives(&mut registry).unwrap();
        
        let names = registry.primitive_names();
        assert_eq!(names.len(), 42);
        
        // Verify specific primitives are registered
        assert!(names.contains(&"+".to_string()));
        assert!(names.contains(&"cons".to_string()));
        assert!(names.contains(&"number?".to_string()));
        assert!(names.contains(&"equal?".to_string()));
        assert!(names.contains(&"display".to_string()));
    }

    #[test]
    fn test_arithmetic_primitives() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_arithmetic_primitives(&mut registry).unwrap();
        
        let add = registry.get("+").unwrap();
        let result = add.evaluate(&[Value::number(2.0), Value::number(3.0)]).unwrap();
        assert_eq!(result.as_number().unwrap(), 5.0);
        
        let multiply = registry.get("*").unwrap();
        let result = multiply.evaluate(&[Value::number(4.0), Value::number(5.0)]).unwrap();
        assert_eq!(result.as_number().unwrap(), 20.0);
    }

    #[test]
    fn test_comparison_primitives() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_comparison_primitives(&mut registry).unwrap();
        
        let lt = registry.get("<").unwrap();
        let result = lt.evaluate(&[Value::number(2.0), Value::number(3.0)]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), true);
        
        let eq = registry.get("=").unwrap();
        let result = eq.evaluate(&[Value::number(2.0), Value::number(2.0)]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), true);
    }

    #[test]
    fn test_list_primitives() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_list_primitives(&mut registry).unwrap();
        
        let cons = registry.get("cons").unwrap();
        let result = cons.evaluate(&[Value::number(1.0), Value::Nil]).unwrap();
        
        let car = registry.get("car").unwrap();
        let first = car.evaluate(&[result.clone()]).unwrap();
        assert_eq!(first.as_number().unwrap(), 1.0);
        
        let cdr = registry.get("cdr").unwrap();
        let rest = cdr.evaluate(&[result]).unwrap();
        assert!(matches!(rest, Value::Nil));
    }

    #[test]
    fn test_type_predicates() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_type_predicate_primitives(&mut registry).unwrap();
        
        let number_pred = registry.get("number?").unwrap();
        let result = number_pred.evaluate(&[Value::number(42.0)]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), true);
        
        let result = number_pred.evaluate(&[Value::string("hello")]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), false);
    }

    #[test]
    fn test_equality_primitives() {
        let mut registry = GenericPrimitiveRegistry::new();
        register_equality_primitives(&mut registry).unwrap();
        
        let equal = registry.get("equal?").unwrap();
        let result = equal.evaluate(&[Value::string("hello".to_string()), Value::string("hello".to_string())]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), true);
        
        let not_fn = registry.get("not").unwrap();
        let result = not_fn.evaluate(&[Value::boolean(false)]).unwrap();
        assert_eq!(result.as_boolean().unwrap(), true);
    }
}