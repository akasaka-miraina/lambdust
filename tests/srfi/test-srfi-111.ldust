#!/usr/bin/env lambdust
;; Test file: SRFI-111 Box (Mutable Cells)
;; Purpose: Comprehensive test suite for SRFI-111 box procedures
;; Tests all box operations, mutation, equality, and edge cases

(import (scheme base)
        (scheme write)
        (lambdust test))

;; =============================================================================
;; BASIC FUNCTIONALITY TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Basic Box Operations"
  
  (test "box constructor creates mutable boxes"
    (define b1 (box 42))
    (assert-true (box? b1))
    (assert-equal 42 (unbox b1))
    
    ;; Test with different value types
    (define b2 (box "hello"))
    (assert-true (box? b2))
    (assert-equal "hello" (unbox b2))
    
    (define b3 (box '(1 2 3)))
    (assert-true (box? b3))
    (assert-equal '(1 2 3) (unbox b3))
    
    (define b4 (box #t))
    (assert-true (box? b4))
    (assert-equal #t (unbox b4)))
  
  (test "box? predicate correctly identifies boxes"
    (define b (box 10))
    (assert-true (box? b))
    
    ;; Non-boxes should return #f
    (assert-false (box? 42))
    (assert-false (box? "string"))
    (assert-false (box? '(1 2 3)))
    (assert-false (box? #t))
    (assert-false (box? #f))
    (assert-false (box? '()))
    (assert-false (box? #(1 2 3)))
    (assert-false (box? (lambda (x) x)))
    (assert-false (box? +)))
  
  (test "unbox extracts values from boxes"
    (define b1 (box 100))
    (assert-equal 100 (unbox b1))
    
    (define b2 (box "test"))
    (assert-equal "test" (unbox b2))
    
    (define b3 (box #f))
    (assert-equal #f (unbox b3))
    
    ;; Test with nested structures
    (define b4 (box '((a . 1) (b . 2))))
    (assert-equal '((a . 1) (b . 2)) (unbox b4)))
  
  (test "set-box! mutates box contents"
    (define b (box 10))
    (assert-equal 10 (unbox b))
    
    ;; Mutate the box
    (set-box! b 20)
    (assert-equal 20 (unbox b))
    
    ;; Mutate to different type
    (set-box! b "changed")
    (assert-equal "changed" (unbox b))
    
    ;; Multiple mutations
    (set-box! b #t)
    (assert-equal #t (unbox b))
    
    (set-box! b '(a b c))
    (assert-equal '(a b c) (unbox b))))

;; =============================================================================
;; MUTATION AND SHARING TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Box Mutation and Sharing"
  
  (test "boxes exhibit reference semantics"
    (define b1 (box 1))
    (define b2 b1)  ; Same box
    
    ;; Both references point to same box
    (assert-equal 1 (unbox b1))
    (assert-equal 1 (unbox b2))
    
    ;; Mutation through one reference affects both
    (set-box! b1 999)
    (assert-equal 999 (unbox b1))
    (assert-equal 999 (unbox b2))
    
    ;; Mutation through other reference
    (set-box! b2 -1)
    (assert-equal -1 (unbox b1))
    (assert-equal -1 (unbox b2)))
  
  (test "different boxes are independent"
    (define b1 (box 10))
    (define b2 (box 10))  ; Different box with same content
    
    ;; Initially same values
    (assert-equal (unbox b1) (unbox b2))
    
    ;; But mutation affects only one
    (set-box! b1 100)
    (assert-equal 100 (unbox b1))
    (assert-equal 10 (unbox b2))
    
    (set-box! b2 200)
    (assert-equal 100 (unbox b1))
    (assert-equal 200 (unbox b2)))
  
  (test "boxes can contain other boxes"
    (define inner-box (box "inner"))
    (define outer-box (box inner-box))
    
    ;; Check nested structure
    (assert-true (box? (unbox outer-box)))
    (assert-equal "inner" (unbox (unbox outer-box)))
    
    ;; Mutation of inner box through outer box
    (set-box! (unbox outer-box) "modified")
    (assert-equal "modified" (unbox inner-box))
    (assert-equal "modified" (unbox (unbox outer-box)))
    
    ;; Replace inner box entirely
    (define new-inner (box "replacement"))
    (set-box! outer-box new-inner)
    (assert-equal "replacement" (unbox (unbox outer-box)))
    (assert-equal "modified" (unbox inner-box)))  ; Original unchanged
  
  (test "boxes in data structures"
    ;; Boxes in lists
    (define b1 (box 1))
    (define b2 (box 2))
    (define box-list (list b1 b2))
    
    (assert-equal 1 (unbox (car box-list)))
    (assert-equal 2 (unbox (cadr box-list)))
    
    ;; Mutation through list
    (set-box! (car box-list) 10)
    (assert-equal 10 (unbox b1))
    
    ;; Boxes in vectors
    (define box-vector (vector b1 b2 (box 3)))
    (assert-equal 10 (unbox (vector-ref box-vector 0)))
    (assert-equal 2 (unbox (vector-ref box-vector 1)))
    (assert-equal 3 (unbox (vector-ref box-vector 2)))))

;; =============================================================================
;; BOX EQUALITY AND IDENTITY TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Box Equality and Identity"
  
  (test "box identity and equality"
    (define b1 (box 42))
    (define b2 (box 42))
    (define b3 b1)
    
    ;; Different boxes with same content are not eq?
    (assert-false (eq? b1 b2))
    (assert-false (eqv? b1 b2))
    (assert-false (equal? b1 b2))  ; Boxes use reference equality
    
    ;; Same box reference is eq?
    (assert-true (eq? b1 b3))
    (assert-true (eqv? b1 b3))
    (assert-true (equal? b1 b3))
    
    ;; After mutation, identity remains but content changes
    (set-box! b1 100)
    (assert-true (eq? b1 b3))  ; Still same box
    (assert-equal 100 (unbox b3)))  ; Content changed through alias
  
  (test "boxes with different content types"
    (define b-num (box 123))
    (define b-str (box "123"))
    (define b-bool (box #t))
    (define b-nil (box '()))
    
    ;; All are boxes
    (assert-true (box? b-num))
    (assert-true (box? b-str))
    (assert-true (box? b-bool))
    (assert-true (box? b-nil))
    
    ;; All different
    (assert-false (eq? b-num b-str))
    (assert-false (eq? b-str b-bool))
    (assert-false (eq? b-bool b-nil))
    
    ;; Content types correctly preserved
    (assert-true (number? (unbox b-num)))
    (assert-true (string? (unbox b-str)))
    (assert-true (boolean? (unbox b-bool)))
    (assert-true (null? (unbox b-nil)))))

;; =============================================================================
;; EDGE CASES AND ERROR HANDLING TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Edge Cases and Error Handling"
  
  (test "boxes with special values"
    ;; Box containing #f
    (define b-false (box #f))
    (assert-true (box? b-false))
    (assert-equal #f (unbox b-false))
    
    ;; Box containing empty list
    (define b-nil (box '()))
    (assert-true (box? b-nil))
    (assert-equal '() (unbox b-nil))
    
    ;; Box containing unspecified value
    (define b-unspec (box (if #f #t)))  ; unspecified value
    (assert-true (box? b-unspec))
    
    ;; Box containing another box
    (define b-box (box (box "nested")))
    (assert-true (box? b-box))
    (assert-true (box? (unbox b-box)))
    (assert-equal "nested" (unbox (unbox b-box))))
  
  (test "error cases"
    ;; unbox on non-box should error
    (assert-error (unbox 42))
    (assert-error (unbox "string"))
    (assert-error (unbox '(1 2 3)))
    (assert-error (unbox #t))
    
    ;; set-box! on non-box should error  
    (assert-error (set-box! 42 10))
    (assert-error (set-box! "string" 10))
    (assert-error (set-box! '(1 2 3) 10))
    
    ;; Wrong number of arguments
    (assert-error (box))           ; Too few
    (assert-error (box 1 2))       ; Too many
    (assert-error (box? ))         ; Too few
    (assert-error (box? 1 2))      ; Too many
    (assert-error (unbox))         ; Too few
    (assert-error (unbox 1 2))     ; Too many
    (assert-error (set-box!))      ; Too few
    (assert-error (set-box! 1))    ; Too few
    (assert-error (set-box! 1 2 3))) ; Too many
  
  (test "boxes with complex nested structures"
    ;; Box containing complex nested structure
    (define complex-structure 
      '((boxes . ((inner . #(1 2 3)) 
                   (data . "test")))
        (numbers . (1 2 3 4 5))))
    
    (define b-complex (box complex-structure))
    (assert-true (box? b-complex))
    (assert-equal complex-structure (unbox b-complex))
    
    ;; Verify structure integrity after mutation
    (define new-structure '(modified))
    (set-box! b-complex new-structure)
    (assert-equal new-structure (unbox b-complex)))
  
  (test "circular references with boxes"
    ;; Create circular structure using boxes
    (define b1 (box 'placeholder))
    (define b2 (box b1))
    (set-box! b1 b2)
    
    ;; Verify circular structure exists
    (assert-true (eq? b1 (unbox (unbox b1))))
    (assert-true (eq? b2 (unbox b1)))
    (assert-true (eq? b1 (unbox b2)))))

;; =============================================================================
;; PERFORMANCE AND THREAD SAFETY TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Performance and Thread Safety"
  
  (test "many boxes performance"
    ;; Create many boxes to test memory efficiency
    (define boxes 
      (map (lambda (i) (box i)) 
           (iota 1000)))
    
    ;; Verify all boxes created correctly
    (assert-equal 1000 (length boxes))
    (assert-true (every box? boxes))
    
    ;; Check first few and last few values
    (assert-equal 0 (unbox (list-ref boxes 0)))
    (assert-equal 1 (unbox (list-ref boxes 1)))
    (assert-equal 999 (unbox (list-ref boxes 999)))
    
    ;; Mutate all boxes
    (for-each (lambda (b i) 
                (set-box! b (* i 2)))
              boxes
              (iota 1000))
    
    ;; Verify mutations
    (assert-equal 0 (unbox (list-ref boxes 0)))
    (assert-equal 2 (unbox (list-ref boxes 1)))
    (assert-equal 1998 (unbox (list-ref boxes 999))))
  
  (test "box operations are constant time"
    ;; All basic box operations should be O(1)
    (define b (box 42))
    
    ;; These should all be very fast
    (assert-true (box? b))
    (assert-equal 42 (unbox b))
    (set-box! b 100)
    (assert-equal 100 (unbox b)))
  
  (test "box thread safety"
    ;; Note: This test assumes thread-safe implementation
    ;; In a single-threaded test environment, this mainly
    ;; verifies that the API works correctly
    
    (define shared-box (box 0))
    
    ;; Simulate concurrent access pattern
    (define (increment-box! box n)
      (do ((i 0 (+ i 1)))
          ((>= i n))
        (set-box! box (+ (unbox box) 1))))
    
    ;; Sequential execution (simulating thread safety)
    (increment-box! shared-box 10)
    (increment-box! shared-box 10)
    
    (assert-equal 20 (unbox shared-box))))

;; =============================================================================
;; SRFI-111 COMPLIANCE AND INTEGRATION TESTS
;; =============================================================================

(define-test-suite "SRFI-111 Compliance and Integration"
  
  (test "SRFI-111 specification compliance"
    ;; Test exact specification requirements
    
    ;; (box obj) -> box
    (define b (box 'test-value))
    (assert-true (box? b))
    
    ;; (box? obj) -> boolean
    (assert-true (boolean? (box? b)))
    (assert-true (boolean? (box? 'not-a-box)))
    
    ;; (unbox box) -> obj
    (assert-equal 'test-value (unbox b))
    
    ;; (set-box! box obj) -> unspecified
    (define result (set-box! b 'new-value))
    ;; Result should be unspecified (implementation dependent)
    (assert-equal 'new-value (unbox b)))
  
  (test "integration with R7RS procedures"
    (define b1 (box 10))
    (define b2 (box 20))
    
    ;; Boxes work with generic procedures
    (assert-true (eq? b1 b1))
    (assert-false (eq? b1 b2))
    
    ;; Boxes in conditional expressions
    (assert-equal 'first 
                  (if (box? b1) 'first 'second))
    
    ;; Boxes as procedure arguments
    (define (process-box b)
      (if (box? b)
          (+ (unbox b) 1)
          #f))
    
    (assert-equal 11 (process-box b1))
    (assert-equal #f (process-box 'not-a-box))
    
    ;; Boxes in let bindings
    (let ((local-box (box 'local-value)))
      (assert-true (box? local-box))
      (assert-equal 'local-value (unbox local-box))
      (set-box! local-box 'modified)
      (assert-equal 'modified (unbox local-box))))
  
  (test "boxes with higher-order procedures"
    ;; map over list of boxes
    (define boxes (list (box 1) (box 2) (box 3)))
    (define values (map unbox boxes))
    (assert-equal '(1 2 3) values)
    
    ;; for-each to mutate boxes
    (for-each (lambda (b) (set-box! b (* (unbox b) 10)))
              boxes)
    (assert-equal '(10 20 30) (map unbox boxes))
    
    ;; filter boxes by content
    (define mixed-boxes 
      (list (box 1) (box -2) (box 3) (box -4)))
    (define positive-boxes
      (filter (lambda (b) (> (unbox b) 0)) mixed-boxes))
    (assert-equal 2 (length positive-boxes))
    (assert-equal '(1 3) (map unbox positive-boxes))))

;; =============================================================================
;; RUN ALL TESTS
;; =============================================================================

(define (run-srfi-111-tests)
  (run-test-suite "SRFI-111 Basic Box Operations")
  (run-test-suite "SRFI-111 Box Mutation and Sharing")
  (run-test-suite "SRFI-111 Box Equality and Identity")
  (run-test-suite "SRFI-111 Edge Cases and Error Handling")
  (run-test-suite "SRFI-111 Performance and Thread Safety")
  (run-test-suite "SRFI-111 Compliance and Integration")
  
  (display "\n=== SRFI-111 Box (Mutable Cells) Test Suite Complete ===\n")
  (test-summary))

;; Helper procedures for testing
(define (iota n)
  "Generate list of integers from 0 to n-1"
  (define (iota-helper i acc)
    (if (< i 0)
        acc
        (iota-helper (- i 1) (cons i acc))))
  (iota-helper (- n 1) '()))

(define (every pred lst)
  "Check if predicate is true for all elements"
  (if (null? lst)
      #t
      (if (pred (car lst))
          (every pred (cdr lst))
          #f)))

;; Run tests if this file is executed directly
(when (and (defined? 'command-line) (not (null? (command-line))))
  (run-srfi-111-tests))