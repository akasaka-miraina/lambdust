;; R7RS Guard Syntax Compliance Tests
;; Tests the complete R7RS guard syntax implementation for full compliance

(define-test-suite "R7RS Guard Syntax Compliance"

  (test "Basic guard with simple condition"
    ;; Test basic guard functionality with a simple predicate
    (define result
      (guard (condition
              ((error-object? condition)
               (string-append "Error: " (error-object-message condition))))
        (error "test error" 1 2 3)))
    
    (assert-equal "Error: test error" result))

  (test "Guard with else clause"
    ;; Test that else clause catches all exceptions
    (define result
      (guard (condition
              ((read-error? condition) 'read-error)
              (else 'other-error))
        (error "test error")))
    
    (assert-equal 'other-error result))

  (test "Guard with => clause"
    ;; Test the => form which applies a procedure to the test result
    (define result
      (guard (condition
              ((error-object? condition) => error-object-message))
        (error "extracted message" 42)))
    
    (assert-equal "extracted message" result))

  (test "Guard with multiple clauses"
    ;; Test multiple clauses with proper precedence
    (define (test-exception-type obj)
      (guard (condition
              ((read-error? condition) 'read-error)
              ((file-error? condition) 'file-error)
              ((error-object? condition) 'general-error)
              (else 'unknown-error))
        (raise obj)))
    
    ;; Test with different exception types
    (assert-equal 'general-error
                  (test-exception-type (error "test")))
    (assert-equal 'unknown-error
                  (test-exception-type 'arbitrary-exception)))

  (test "Guard with no matching clause re-raises exception"
    ;; Test that unmatched exceptions are properly re-raised
    (define caught-exception #f)
    
    (guard (outer-condition
            (else (set! caught-exception outer-condition) 'caught))
      (guard (inner-condition
              ((read-error? inner-condition) 'read-error))
        (error "unmatched error")))
    
    (assert-equal 'caught 'caught)
    (assert-true (error-object? caught-exception))
    (assert-equal "unmatched error" (error-object-message caught-exception)))

  (test "Guard exception variable binding"
    ;; Test that the exception variable is properly bound
    (define exception-message
      (guard (condition
              (#t (if (error-object? condition)
                      (error-object-message condition)
                      "not an error object")))
        (error "bound variable test")))
    
    (assert-equal "bound variable test" exception-message))

  (test "Guard with normal completion"
    ;; Test that guard returns normally when no exception is raised
    (define result
      (guard (condition
              (else 'should-not-reach))
        (+ 1 2 3)))
    
    (assert-equal 6 result))

  (test "Guard with continuable exceptions"
    ;; Test guard with raise-continuable
    (define results '())
    
    (define final-result
      (guard (condition
              ((error-object? condition)
               (set! results (cons 'handled results))
               'recovery-value))
        (set! results (cons 'before-raise results))
        (raise-continuable (error "continuable"))
        (set! results (cons 'after-raise results))
        'normal-completion))
    
    ;; With continuable exceptions, execution should continue after handler
    (assert-equal 'recovery-value final-result)
    (assert-equal '(handled before-raise) results))

  (test "Guard with nested exception handling"
    ;; Test nested guard expressions
    (define result
      (guard (outer-condition
              ((error-object? outer-condition) 'outer-caught))
        (guard (inner-condition
                ((read-error? inner-condition) 'inner-read-error))
          (guard (innermost-condition
                  ((file-error? innermost-condition) 'innermost-file-error)
                  (else 'innermost-other))
            (error "nested test")))))
    
    (assert-equal 'outer-caught result))

  (test "Guard with complex condition expressions"
    ;; Test complex conditions with compound expressions
    (define result
      (guard (condition
              ((and (error-object? condition)
                    (string=? (error-object-message condition) "specific"))
               'specific-error)
              ((and (error-object? condition)
                    (not (null? (error-object-irritants condition))))
               'error-with-irritants)
              (else 'other))
        (error "specific")))
    
    (assert-equal 'specific-error result))

  (test "Guard integration with with-exception-handler"
    ;; Test that guard works correctly with with-exception-handler
    (define results '())
    
    (define final-result
      (with-exception-handler
        (lambda (exn)
          (set! results (cons 'handler-called results))
          'handler-result)
        (lambda ()
          (guard (condition
                  ((error-object? condition)
                   (set! results (cons 'guard-caught results))
                   'guard-result))
            (error "test error")))))
    
    ;; Guard should catch the exception before with-exception-handler
    (assert-equal 'guard-result final-result)
    (assert-equal '(guard-caught) results))

  (test "Guard variable scoping"
    ;; Test that the exception variable doesn't leak outside guard
    (define condition 'outer-value)
    
    (guard (condition
            (#t 'handled))
      (error "test"))
    
    ;; The outer 'condition' should remain unchanged
    (assert-equal 'outer-value condition))

  (test "Guard with syntactic keywords in condition"
    ;; Test that syntactic keywords can be used in conditions
    (define result
      (guard (condition
              ((and (error-object? condition)
                    (let ((msg (error-object-message condition)))
                      (string=? msg "keyword test")))
               'keyword-matched)
              (else 'no-match))
        (error "keyword test")))
    
    (assert-equal 'keyword-matched result))

  (test "Empty guard body"
    ;; Test guard with empty body (should return unspecified)
    (define result
      (guard (condition
              (else 'caught))
        ;; Empty body
        ))
    
    ;; Empty body should return unspecified value
    (assert-true (eq? result (if #f #f))))

  (test "Guard with multiple body expressions"
    ;; Test guard with multiple expressions in body
    (define side-effect 0)
    
    (define result
      (guard (condition
              (else 'caught))
        (set! side-effect 1)
        (set! side-effect 2)
        (+ 10 20)))
    
    (assert-equal 30 result)
    (assert-equal 2 side-effect)))

;; Integration tests with SRFI implementations
(define-test-suite "Guard SRFI Integration"

  (test "Guard with SRFI-23 error objects"
    ;; Test guard with traditional SRFI-23 error procedure
    (define result
      (guard (condition
              ((error-object? condition) 'caught-error))
        (error "SRFI-23 style error")))
    
    (assert-equal 'caught-error result))

  (test "Guard with custom exception types"
    ;; Test guard with user-defined exception types
    (define (make-custom-exception type data)
      (list 'custom-exception type data))
    
    (define (custom-exception? obj)
      (and (pair? obj)
           (eq? (car obj) 'custom-exception)))
    
    (define result
      (guard (condition
              ((custom-exception? condition)
               (list-ref condition 2))
              (else 'not-custom))
        (raise (make-custom-exception 'test "custom data"))))
    
    (assert-equal "custom data" result)))

;; Performance and edge case tests
(define-test-suite "Guard Edge Cases and Performance"

  (test "Guard with very large exception objects"
    ;; Test that guard handles large exception objects efficiently
    (define large-irritants (make-list 1000 'large-data))
    
    (define result
      (guard (condition
              ((error-object? condition)
               (length (error-object-irritants condition))))
        (apply error "large error" large-irritants)))
    
    (assert-equal 1000 result))

  (test "Guard with deeply nested exceptions"
    ;; Test guard performance with deeply nested exception handling
    (define (nested-guard depth)
      (if (= depth 0)
          (error "deep error")
          (guard (condition
                  ((error-object? condition)
                   (cons depth (list (error-object-message condition)))))
            (nested-guard (- depth 1)))))
    
    (define result (nested-guard 10))
    (assert-equal 10 (car result))
    (assert-equal "deep error" (cadr result))))