//! Integration tests for SRFI module import functionality
//!
//! This test suite verifies that the Lambdust module system properly handles
//! SRFI imports using the `(import (srfi N))` syntax and that the imported
//! functionality works correctly in isolation and integration scenarios.
//!
//! Tested SRFI modules:
//! - SRFI-2: and-let* (conditional binding and testing)
//! - SRFI-8: receive (multiple value binding)
//! - SRFI-11: let-values/let*-values (multiple value bindings)

use lambdust::{Lambdust, Result, Value};

/// Test helper for creating a new Lambdust instance
fn create_lambdust() -> Lambdust {
    Lambdust::new()
}

/// Test helper for evaluating code and asserting specific result types
fn eval_assert_integer(lambdust: &mut Lambdust, code: &str, expected: i64) -> Result<()> {
    let result = lambdust.eval(code, Some("srfi-test"))?;
    if let Some(n) = result.as_integer() {
        assert_eq!(n, expected, "Expected {}, got {}", expected, n);
        Ok(())
    } else {
        panic!("Expected integer {}, got {:?}", expected, result);
    }
}

/// Test helper for evaluating code and asserting boolean results
fn eval_assert_boolean(lambdust: &mut Lambdust, code: &str, expected: bool) -> Result<()> {
    let result = lambdust.eval(code, Some("srfi-test"))?;
    if let Some(b) = result.as_boolean() {
        assert_eq!(b, expected, "Expected {}, got {}", expected, b);
        Ok(())
    } else {
        panic!("Expected boolean {}, got {:?}", expected, result);
    }
}

/// Test helper for evaluating code and asserting string results
fn eval_assert_string(lambdust: &mut Lambdust, code: &str, expected: &str) -> Result<()> {
    let result = lambdust.eval(code, Some("srfi-test"))?;
    if let Some(s) = result.as_string() {
        assert_eq!(s, expected, "Expected '{}', got '{}'", expected, s);
        Ok(())
    } else {
        panic!("Expected string '{}', got {:?}", expected, result);
    }
}

/// Test helper for evaluating code and asserting it returns false
fn eval_assert_false(lambdust: &mut Lambdust, code: &str) -> Result<()> {
    eval_assert_boolean(lambdust, code, false)
}

/// Test helper for evaluating code and asserting it returns true  
fn eval_assert_true(lambdust: &mut Lambdust, code: &str) -> Result<()> {
    eval_assert_boolean(lambdust, code, true)
}

// ===== BASIC FUNCTIONALITY TESTS (Direct Access) =====

#[test]
fn test_srfi_2_direct_functionality() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that and-let* is directly available (built into the runtime)
    eval_assert_integer(
        &mut lambdust,
        r#"
        (and-let* ((x 5)
                   (y 10))
          (+ x y))
    "#,
        15,
    )
}

#[test]
#[ignore] // TODO: Enable when SRFI import system is fixed
fn test_srfi_2_basic_import() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that SRFI-2 imports without error
    lambdust.eval("(import (srfi 2))", Some("srfi-2-import-test"))?;

    // Verify and-let* is available after import
    eval_assert_integer(
        &mut lambdust,
        r#"
        (and-let* ((x 5)
                   (y 10))
          (+ x y))
    "#,
        15,
    )
}

#[test]
fn test_srfi_8_direct_functionality() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that receive is directly available
    eval_assert_integer(
        &mut lambdust,
        r#"
        (receive (a b) (values 1 2) (+ a b))
    "#,
        3,
    )
}

#[test]
fn test_srfi_11_direct_functionality() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that let-values is directly available
    eval_assert_integer(
        &mut lambdust,
        r#"
        (let-values ([(a b) (values 1 2)])
          (+ a b))
    "#,
        3,
    )
}

#[test]
#[ignore] // TODO: Enable when SRFI import system is fixed
fn test_srfi_8_basic_import() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that SRFI-8 imports without error
    lambdust.eval("(import (srfi 8))", Some("srfi-8-import-test"))?;

    // Verify receive is available after import
    eval_assert_integer(
        &mut lambdust,
        r#"
        (receive (a b) (values 1 2) (+ a b))
    "#,
