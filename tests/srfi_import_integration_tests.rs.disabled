#[test]
#[ignore] // TODO: Enable when SRFI import system is fixed
fn test_srfi_11_basic_import() -> Result<()> {
    let mut lambdust = create_lambdust();

    // Test that SRFI-11 imports without error
    lambdust.eval("(import (srfi 11))", Some("srfi-11-import-test"))?;

    // Verify let-values is available after import
    eval_assert_integer(
        &mut lambdust,
        r#"
        (let-values ([(a b) (values 1 2)])
          (+ a b))
    "#,
        3,
