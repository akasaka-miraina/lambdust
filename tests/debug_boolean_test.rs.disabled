//! Debug test for boolean value issue

use lambdust::Lambdust;

#[test]
fn debug_string_index_boolean() {
    let source = r#"(string-index "hello" #\x)"#;

    let mut lambdust = Lambdust::new();
    let result = lambdust.eval(source, Some("test"));

    match result {
        Ok(value) => {
            println!("Result value: {value:?}");
            println!("as_boolean(): {:?}", value.as_boolean());
            println!("Value type: {}", std::any::type_name_of_val(&value));

            // Check if it's a literal
            match &value {
                lambdust::eval::value::Value::Literal(lit) => {
                    println!("Literal: {lit:?}");
                    match lit {
                        lambdust::ast::literal::Literal::Boolean(b) => {
                            println!("Boolean value: {b}");
                            assert!(!(*b));
                        }
                        _ => println!("Not a boolean literal"),
                    }
                }
                _ => println!("Not a literal"),
            }
        }
        Err(e) => {
            panic!("Evaluation failed: {e:?}");
        }
    }
}
