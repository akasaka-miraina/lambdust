//! Comprehensive integration tests for Phase 5 Stage 6 Quality Assurance System
//!
//! This test suite validates the complete quality assurance system integration
//! across all Stage 1-5 systems, ensuring enterprise-grade quality validation,
//! regression detection, security auditing, stability monitoring, and compliance
//! management functionality.

#[cfg(feature = "quality-assurance")]
mod quality_assurance_integration_tests {
    use lambdust::eval::{
        AlertSettings, ComprehensiveValidationResult, QualityAssuranceConfig,
        QualityAssuranceSystem, QualityMetrics, SLATargets, SystemOperationalStatus, TestCase,
        TestOrchestrator, TestPriority, TestStatus, TestStrategy,
    };

    use std::collections::HashMap;
    use std::time::{Duration, SystemTime};
    use tokio_test;

    #[tokio::test]
    async fn test_quality_assurance_system_initialization() {
        let config = QualityAssuranceConfig::default();
        let qa_system = QualityAssuranceSystem::new(config);

        // Verify initial system status
        let status = qa_system.get_system_status().unwrap();
        assert_eq!(status.overall_status, SystemOperationalStatus::Healthy);
        assert_eq!(status.evaluation_count, 0);

        // Verify initial quality metrics
        let metrics = qa_system.get_quality_metrics().unwrap();
        assert_eq!(metrics.overall_score, 0.0);
        assert_eq!(metrics.security_vulnerabilities, 0);
    }

    #[tokio::test]
    async fn test_comprehensive_quality_validation() {
        let mut config = QualityAssuranceConfig::default();
        config.sla_targets = SLATargets {
            target_availability: 99.99,
            target_response_time: Duration::from_millis(10),
            target_error_rate: 0.01,
            target_recovery_time: Duration::from_secs(300),
        };

        let qa_system = QualityAssuranceSystem::new(config);

        // Execute comprehensive validation
        let validation_result = qa_system.execute_comprehensive_validation().await.unwrap();

        // Validate results structure
        assert!(validation_result.overall_quality_score >= 0.0);
        assert!(validation_result.overall_quality_score <= 100.0);
        assert!(validation_result.total_duration > Duration::ZERO);
        assert!(!validation_result.recommendations.is_empty());

        // Verify test execution stats
        assert!(validation_result.test_execution_stats.total_tests >= 0);
    }

    #[tokio::test]
    async fn test_test_orchestrator_sequential_execution() {
        let orchestrator = TestOrchestrator::new(TestStrategy::Sequential, 4);

        // Add multiple test cases with different priorities
        let test_cases = vec![
            TestCase {
                id: 1,
                name: "Critical System Test".to_string(),
                description: "Test critical system functionality".to_string(),
                priority: TestPriority::Critical,
                estimated_duration: Duration::from_millis(50),
                dependencies: Vec::new(),
                stage_requirements: &["stage1".to_string()],
            },
            TestCase {
                id: 2,
                name: "High Priority Test".to_string(),
                description: "Test high priority features".to_string(),
                priority: TestPriority::High,
                estimated_duration: Duration::from_millis(30),
                dependencies: Vec::new(),
                stage_requirements: &["stage2".to_string()],
            },
            TestCase {
                id: 3,
                name: "Medium Priority Test".to_string(),
                description: "Test medium priority features".to_string(),
                priority: TestPriority::Medium,
                estimated_duration: Duration::from_millis(40),
                dependencies: Vec::new(),
                stage_requirements: &["stage3".to_string()],
            },
        ];

        for test_case in test_cases {
            orchestrator.add_test(test_case).unwrap();
        }

        // Execute all tests
        let stats = orchestrator.execute_all_tests().await.unwrap();

        // Validate execution results
        assert_eq!(stats.total_tests, 3);
        assert_eq!(stats.passed_tests, 3);
        assert_eq!(stats.failed_tests, 0);
        assert!(stats.total_execution_time > Duration::ZERO);
    }

    #[tokio::test]
    async fn test_test_orchestrator_parallel_execution() {
        let orchestrator = TestOrchestrator::new(TestStrategy::Parallel(2), 4);

        // Add test cases for parallel execution
        for i in 0..5 {
            let test_case = TestCase {
                id: i,
                name: format!("Parallel Test {}", i),
                description: format!("Test parallel execution {}", i),
                priority: TestPriority::Medium,
                estimated_duration: Duration::from_millis(100),
                dependencies: Vec::new(),
                stage_requirements: Vec::new(),
            };
            orchestrator.add_test(test_case).unwrap();
        }

        let start_time = std::time::Instant::now();
        let stats = orchestrator.execute_all_tests().await.unwrap();
        let execution_time = start_time.elapsed();

        // Validate execution results
        assert_eq!(stats.total_tests, 5);
        assert_eq!(stats.passed_tests, 5);
        assert!(execution_time < Duration::from_secs(1)); // Should complete quickly
    }

    #[tokio::test]
    async fn test_quality_assurance_system_start_stop() {
        let config = QualityAssuranceConfig::default();
        let qa_system = QualityAssuranceSystem::new(config);

        // Start quality assurance
        qa_system.start_quality_assurance().await.unwrap();

        // Let it run briefly
        tokio::time::sleep(Duration::from_millis(100)).await;

        // Verify system is operational
        let status = qa_system.get_system_status().unwrap();
        assert_eq!(status.overall_status, SystemOperationalStatus::Healthy);

        // Shutdown system
        qa_system.shutdown().await.unwrap();
    }

    #[tokio::test]
    async fn test_sla_compliance_monitoring() {
        let mut config = QualityAssuranceConfig::default();
        config.sla_targets = SLATargets {
            target_availability: 99.99,
            target_response_time: Duration::from_millis(5), // Very strict
            target_error_rate: 0.001,                       // Very strict
            target_recovery_time: Duration::from_secs(60),
        };

        let qa_system = QualityAssuranceSystem::new(config);

        // Evaluate quality (may trigger SLA violations due to strict targets)
        let _result = qa_system.evaluate_overall_quality().await;

        let metrics = qa_system.get_quality_metrics().unwrap();

        // Verify SLA metrics are populated
        assert!(metrics.sla_metrics.availability >= 0.0);
        assert!(metrics.sla_metrics.response_time_p95 >= Duration::ZERO);
        assert!(metrics.sla_metrics.error_rate >= 0.0);
    }

    #[tokio::test]
    async fn test_quality_metrics_aggregation() {
        let config = QualityAssuranceConfig::default();
        let qa_system = QualityAssuranceSystem::new(config);

        // Execute quality evaluation
        let metrics = qa_system.evaluate_overall_quality().await.unwrap();

        // Validate metric structure and ranges
        assert!(metrics.overall_score >= 0.0 && metrics.overall_score <= 100.0);
        assert!(metrics.test_coverage >= 0.0 && metrics.test_coverage <= 100.0);
        assert!(metrics.regression_level >= 0.0);
        assert!(metrics.security_vulnerabilities >= 0);
        assert!(metrics.stability_uptime >= 0.0 && metrics.stability_uptime <= 100.0);
        assert!(metrics.compliance_score >= 0.0 && metrics.compliance_score <= 100.0);

        // Validate SLA metrics
        assert!(
            metrics.sla_metrics.availability >= 0.0 && metrics.sla_metrics.availability <= 100.0
        );
        assert!(metrics.sla_metrics.response_time_p95 >= Duration::ZERO);
        assert!(metrics.sla_metrics.error_rate >= 0.0);
        assert!(metrics.sla_metrics.recovery_time >= Duration::ZERO);
    }

    #[tokio::test]
    async fn test_system_performance_under_load() {
        let config = QualityAssuranceConfig::default();
        let qa_system = QualityAssuranceSystem::new(config);

        let start_time = std::time::Instant::now();

        // Perform multiple concurrent operations
        let validation_handle =
            tokio::spawn(
                async move { qa_system.execute_comprehensive_validation().await.unwrap() },
            );

        let result = validation_handle.await.unwrap();
        let total_time = start_time.elapsed();

        // Validate performance characteristics
        assert!(result.validation_passed || !result.validation_passed); // Either outcome is valid
        assert!(total_time < Duration::from_secs(10)); // Should complete within reasonable time
        assert!(result.overall_quality_score >= 0.0);
    }

    #[tokio::test]
    async fn test_stage_integration_compatibility() {
        // Test that quality assurance system works with different stage configurations
        let config = QualityAssuranceConfig::default();
        let qa_system = QualityAssuranceSystem::new(config);

        // This test verifies that the QA system works regardless of which stages are compiled in
        let validation_result = qa_system.execute_comprehensive_validation().await.unwrap();

        // Should complete successfully regardless of stage availability
        assert!(validation_result.overall_quality_score >= 0.0);
        assert!(!validation_result.recommendations.is_empty());
    }
}

// Provide stub tests when feature is disabled
#[cfg(not(feature = "quality-assurance"))]
mod quality_assurance_stub_tests {
    #[test]
    fn test_quality_assurance_feature_disabled() {
        // This test verifies that the build works even when quality-assurance feature is disabled
        assert!(
            true,
            "Quality assurance feature is disabled - using stub implementation"
        );
    }
}
